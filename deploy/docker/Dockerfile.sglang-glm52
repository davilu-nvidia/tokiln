# SGLang >= 0.5.13.post1 (GLM-5.2 minimum). After the ta-repro archaeology, pin the base image and every pip version.
ARG SGLANG_VERSION=0.5.13.post1
FROM lmsysorg/sglang:v${SGLANG_VERSION}-cu124
# No in-place pip upgrades — every change goes through this Dockerfile rebuild plus a VERSIONS.lock digest update.
LABEL org.tokiln.component=sglang-glm52
