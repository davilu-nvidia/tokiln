# Dynamo + custom SGLang adapter (spike 02: upstream pins sglang 0.5.11, conflicting with GLM-5.2).
ARG DYNAMO_VERSION=1.2.1
FROM nvcr.io/nvidia/ai-dynamo/dynamo:${DYNAMO_VERSION}
# TODO(spike 02): overlay-install the sglang 0.5.13.post1 adapter, run the contract test, then pin.
LABEL org.tokiln.component=dynamo
